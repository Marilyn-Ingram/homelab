# Terraform working files and state (state can contain sensitive values)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log

# Your private values
terraform/terraform.tfvars
terraform/backend.hcl

# Generated by Terraform on each apply
ansible/inventory.ini

# Never commit keys (yours live in ~/.ssh, outside this repo)
*.pem
*.key
id_rsa*
